# 문자열

thanks = 'thanks' # 작은 따옴표 사용
name = "sang mi" # 큰 따옴표도 사용할 수 있음

tn = thanks + name 
tn2 = thanks + ' ' + name # 두 변수와 공백 연결
# thanks와 name 변수가 코드 이전에 먼저 정의돼 있어야 함
# 문자열 연결, 다른 두 변수의 값을 더해(연결) 새로운 문자열을 만드는 것

hw = "hello '' world" 
# 조건 없이, 공정 값 그대로 독립적으로 바로 실행(작은 따옴표도 그대로 표시됨)

# print 
print(thanks) # thanks 출력
print(name) 
print(len(thanks)) # 문자열 길이 출력하는 함수 = "6"
print(hw)
print(tn)
print(tn2)

