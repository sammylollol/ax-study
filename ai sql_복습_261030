-- ⑤ 이벤트 응모자 중 휴면 고객의 이름과 관심분야는? 

-- JOIN... 데이터정규화.(정리가 잘되어 있고, 중복이 없는 데이터 셋)

/**
SELECT e.이름,
       e.관심분야
FROM 이벤트응모 e
JOIN 고객명단 c ON e.이메일 = c.이메일
WHERE c.등급 = '휴면';
*/

DESC 고객명단;
DESC 이벤트응모;

-- 고객명단과 이벤트응모 테이블의 공통 KEY인 이메일을 매개로 INNER JOIN 하는 방법.
-- INNER JOIN (기준, 두 테일블의 공통분모_교집합) ; 두 테이블의 공통 데이터만 결합.
-- 쿼리문에서 왼쪽(먼저 쓴) 테이블의 데이터를 무조건 다 보여주고, 오른쪽 테이블은 매칭되는 값이 있을 때만 가져옵니다. 
-- 용도 ; 진짜 회원 중 이벤트 응모자만 보

SELECT A.이름, A.관심분야 AS '관심분야에요'
FROM 이벤트응모 A 
JOIN 고객명단 G ON A.이메일 = G.이메일;

-- LIGHT JOIN (기준,왼쪽 테이블 전) ; 왼쪽 테이블 전체 + 오른쪽 매칭 데이터 결합
-- 쿼리문에서 왼쪽(먼저 쓴) 테이블의 데이터를 무조건 다 보여주고, 오른쪽 테이블은 매칭되는 값이 있을 때만 가져옵니다. 
-- 용도 ; 전체 회원의 이벤트 참여 여부 확인

SELECT A.이름, A.관심분야 AS '관심분야(LEFT)'
FROM 이벤트응모 A 
LEFT JOIN 고객명단 G ON A.이메일 = G.이메일;

-- RIGHT JOIN (기준,오른쪽 테이블 전체) ; 오른쪽 테이블 전체 + 왼쪽 매칭 데이터 결합
-- 쿼리문에서 오른쪽(나중에 쓴) 테이블을 기준으로 삼아 오른쪽 데이터는 무조건 다 보여주고, 왼쪽 테이블은 매칭되는 값이 있을 때만 가져오는 방식입니다.
-- 매칭 안 된 우측 데이터는 NULL로 채워서 출력
-- 용도 ; 이벤트 응모자 중 비회원/회원 식별

SELECT A.이름, A.관심분야 AS '관심분야(RIGHT)'
FROM 이벤트응모 A 
RIGHT JOIN 고객명단 G ON A.이메일 = G.이메일;

--  RIGHT JOIN 중 회원/비회원 여부만 따로 적용하려면?
-- 이벤트에 참여하지 않은 "일반 회원"만 골라내기
SELECT G.이름, G.이메일, G.등급
FROM 이벤트응모 A 
RIGHT JOIN 고객명단 G ON A.이메일 = G.이메일
WHERE A.이메일 IS NULL; -- 👈 이벤트 응모 기록이 없는 사람만 필터링

-- 이벤트에 참여한 "진짜 회원"만 골라내기 (INNER JOIN과 동일)
SELECT G.이름, G.이메일, A.관심분야 AS '관심분야(RIGHT)'
FROM 이벤트응모 A 
RIGHT JOIN 고객명단 G ON A.이메일 = G.이메일
WHERE A.이메일 IS NOT NULL; -- 👈 이벤트 응모 기록이 확실히 있는 사람만 필터링

-- 한 화면에서 '회원/비회원' 글자로 글자로 변환해서 한눈에 보고 싶다면?
SELECT 
    G.이름, 
    G.이메일,
    CASE 
        WHEN A.이메일 IS NULL THEN '미참여자'
        ELSE '이벤트 참여자'
    END AS '이벤트 참여여부'
FROM 이벤트응모 A 



